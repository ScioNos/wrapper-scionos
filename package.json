{
  "name": "wrapper-scionos",
  "version": "4.2.0",
  "description": "Extensible ScioNos CLI wrapper for RouterLab-backed coding assistants",
  "type": "module",
  "main": "index.js",
  "bin": {
    "wrapper-scionos": "index.js",
    "scionos": "index.js"
  },
  "files": [
    "index.js",
    "src",
    "docs",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:codex-real": "node --test tests/codex-real-cli.integration.mjs",
    "start": "node index.js",
    "test:entry-modes": "node tests/run-entry-mode-smokes.mjs",
    "test:coverage": "node tests/run-coverage.mjs",
    "release:check": "npm test && npm run test:coverage && npm run test:entry-modes && npm audit && npm pack --dry-run"
  },
  "keywords": [
    "scionos",
    "routerlab",
    "claude-code",
    "claude-desktop",
    "codex",
    "wrapper"
  ],
  "author": "ScioNos",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScioNos/wrapper-scionos.git"
  },
  "homepage": "https://github.com/ScioNos/wrapper-scionos#readme",
  "bugs": {
    "url": "https://github.com/ScioNos/wrapper-scionos/issues"
  }
}
